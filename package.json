{
    "name": "rhelboat",
    "version": "0.9.0",
    "description": "Enterprise Linux practice, one command at a time. Guided lessons and isolated container labs.",
    "type": "module",
    "main": "build/main/main.js",
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "dev": "node scripts/dev-server.ts",
        "preview": "vite --host 127.0.0.1",
        "build": "node scripts/build.ts",
        "typecheck": "tsc -p src/main --noEmit && vue-tsc -p src/renderer --noEmit",
        "test": "node --test \"tests/*.test.ts\"",
        "build:linux": "node scripts/build.ts && electron-builder --linux",
        "build:win": "node scripts/build.ts && electron-builder --win --x64"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ochoaj92-lgtm/RHELboat.git"
    },
    "author": {
        "name": "RHELboat contributors",
        "url": "https://github.com/ochoaj92-lgtm/RHELboat/graphs/contributors"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.4",
        "autoprefixer": "^10.4.24",
        "chalk": "^5.6.2",
        "chokidar": "^5.0.0",
        "electron": "^43.2.0",
        "electron-builder": "^26.7.0",
        "postcss": "^8.5.6",
        "prettier": "3.8.1",
        "tailwindcss": "^3.4.17",
        "typescript": "~5.9.3",
        "vite": "^7.3.1",
        "vue-tsc": "^3.2.4"
    },
    "dependencies": {
        "@types/xterm": "^2.0.3",
        "vue": "^3.5.27",
        "xterm": "^5.3.0"
    },
    "homepage": "https://github.com/ochoaj92-lgtm/RHELboat#readme",
    "bugs": {
        "url": "https://github.com/ochoaj92-lgtm/RHELboat/issues"
    },
    "license": "MIT",
    "keywords": [
        "rhel",
        "enterprise-linux",
        "linux-training",
        "podman",
        "docker",
        "electron",
        "linux-administration",
        "workbooks"
    ],
    "desktopName": "rhelboat.desktop"
}
