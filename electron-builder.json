{
    "appId": "app.rhelboat.trainer",
    "productName": "RHELboat",
    "npmRebuild": false,
    "directories": {
        "output": "dist"
    },
    "publish": null,
    "nsis": {
        "oneClick": false,
        "perMachine": false,
        "allowToChangeInstallationDirectory": true,
        "shortcutName": "RHELboat",
        "installerIcon": "icons/rhelboat.ico",
        "uninstallerIcon": "icons/rhelboat.ico",
        "installerHeaderIcon": "icons/rhelboat.ico",
        "installerHeader": "icons/installer-header.bmp",
        "installerSidebar": "icons/installer-sidebar.bmp",
        "uninstallerSidebar": "icons/installer-sidebar.bmp"
    },
    "win": {
        "target": "nsis",
        "icon": "icons/rhelboat.ico"
    },
    "linux": {
        "icon": "icons/png",
        "target": ["appimage", "deb", "rpm", "tar.bz2"],
        "category": "Education",
        "maintainer": "RHELboat contributors",
        "artifactName": "${name}-${version}-${arch}.${ext}",
        "desktop": {
            "entry": {
                "Comment": "Step-by-step Enterprise Linux practice with local container labs",
                "Keywords": "linux;training;rhcsa;rhce;certification;podman;docker;"
            }
        },
        "executableName": "rhelboat",
        "syncDesktopName": true
    },
    "files": [
        {
            "from": "build/main",
            "to": "main",
            "filter": ["**/*"]
        },
        {
            "from": "build/renderer",
            "to": "renderer",
            "filter": ["**/*"]
        },
        "!build",
        "!dist",
        "!scripts"
    ],
    "extraResources": [
        {
            "from": "./labs",
            "to": "labs",
            "filter": ["**/*"]
        }
    ],
    "mac": {
        "icon": "icons/rhelboat.icns",
        "category": "public.app-category.education"
    }
}
