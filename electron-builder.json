{
    "appId": "app.rhelboat.trainer",
    "productName": "RHELboat",
    "npmRebuild": false,
    "directories": {
        "output": "dist"
    },
    "publish": null,
    "linux": {
        "icon": "icons/png",
        "target": ["appimage", "deb", "rpm", "pacman", "tar.bz2"],
        "category": "Education",
        "maintainer": "RHELboat contributors",
        "artifactName": "${name}-${version}-${arch}.${ext}",
        "desktop": {
            "entry": {
                "Comment": "Step-by-step Enterprise Linux practice with local container labs",
                "Keywords": "linux;training;administration;workbooks;podman;docker;"
            }
        },
        "executableName": "rhelboat",
        "syncDesktopName": true
    },
    "files": [
        {
            "from": "build/main",
            "to": "main",
            "filter": ["**/*"]
        },
        {
            "from": "build/renderer",
            "to": "renderer",
            "filter": ["**/*"]
        },
        "package.json",
        "LICENSE",
        "!**/*.pdf",
        "!**/.git/**"
    ],
    "extraResources": [
        {
            "from": "./labs",
            "to": "labs",
            "filter": ["**/*"]
        }
    ],
    "extraMetadata": {
        "main": "main/main.js"
    },
    "win": {
        "target": [
            {
                "target": "nsis",
                "arch": ["x64"]
            }
        ],
        "icon": "icons/rhelboat.ico",
        "artifactName": "RHELboat-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
        "oneClick": false,
        "perMachine": false,
        "allowElevation": false,
        "allowToChangeInstallationDirectory": true,
        "runAfterFinish": false,
        "createDesktopShortcut": true,
        "createStartMenuShortcut": true,
        "shortcutName": "RHELboat",
        "deleteAppDataOnUninstall": false,
        "installerIcon": "icons/rhelboat.ico",
        "uninstallerIcon": "icons/rhelboat.ico",
        "installerHeader": "icons/installer-header.bmp",
        "installerSidebar": "icons/installer-sidebar.bmp",
        "uninstallerSidebar": "icons/installer-sidebar.bmp",
        "license": "LICENSE"
    },
    "afterPack": "scripts/verify-package.cjs"
}
