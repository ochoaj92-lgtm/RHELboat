{
    "compilerOptions": {
        "target": "esnext",
        "useDefineForClassFields": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "strict": true,
        "jsx": "preserve",
        "sourceMap": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "lib": ["esnext", "dom"],
        "types": ["vite/client"]
    },
    "include": [
        "./main.ts",
        "./App.vue",
        "./views/Trainer.vue",
        "./components/TrainerIcon.vue",
        "./data/curriculum.ts",
        "./window.d.ts",
        "./vite-env.d.ts"
    ]
}
